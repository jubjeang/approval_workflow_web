  if ((action === 'REJECT' || action === 'RETURN') && !remark.value.trim()) {
    alert('Please enter a remark before proceeding.')
    return
  }

  actionLoading.value = true
  try {
    const result = await fetchJson(`${API_BASE}/api/approvals/${detail.value.Id}/action`, {
      method: 'POST',
      headers: {
